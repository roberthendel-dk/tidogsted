// Opsætning af Cloudflare-workeren "tidogsted" (https://tidogsted.robert-hendel.workers.dev).
{
  "name": "tidogsted",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./", "binding": "ASSETS" },
  // Fælles lagerplads (KV), så OK'er, rettelser, URL'er m.m. huskes på alle enheder.
  // Uden id opretter Cloudflare den selv ved næste udrulning (automatic provisioning).
  "kv_namespaces": [{ "binding": "TS" }]
}
